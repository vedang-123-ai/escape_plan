# Xcode
*.xcuserstate
xcuserdata/
DerivedData/
# `xcodebuild -target ...` without -derivedDataPath drops build products here
build/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# macOS
.DS_Store

# Claude — shared control center (.claude/) is committed; only local overrides are ignored
.claude/settings.local.json

# Secrets
.env
.env.*
# Shared backend bearer token bundled into demo builds — never committed (see APIClient.swift)
escape_plan/BackendConfig.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Build artifacts: S2.4 export acceptance, SwiftPM harnesses (tools/editorcore), xcodebuild CLI output
.build/
.build-*/
build/

# S1.3 acceptance run artifacts (screenshots + test logs) — regenerate via scripts/s13-acceptance.sh
artifacts/
.build-s13/
# xcodebuild -derivedDataPath output from the 2026-07-22 integration verification pass
.build-merge/
# private derived data for the 2026-07-22 device-acceptance pass (isolated from concurrent sessions)
.build-p3/
# Lane A (lane/editor) derived data — parallel-lane isolation
.build-laneA/
.build-*.log
demo-homes/

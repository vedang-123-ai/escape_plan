# Xcode
*.xcuserstate
xcuserdata/
DerivedData/
# `xcodebuild -target ...` without -derivedDataPath drops build products here
build/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# macOS
.DS_Store

# Claude — shared control center (.claude/) is committed; only local overrides are ignored
.claude/settings.local.json
.superset/config.local.json

# Secrets
.env
.env.*
# Shared backend bearer token bundled into demo builds — never committed (see APIClient.swift)
escape_plan/BackendConfig.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Build artifacts: SwiftPM (tools/editorcore) and xcodebuild CLI output. `.build-*` covers derived-data folders,
# logs and .xcresult bundles left in the repo root; put new logs under `.build/logs/` instead (scripts/clean.sh wipes both).
.build/
.build-*
build/

# S1.3 acceptance run artifacts (screenshots + test logs) — regenerate via scripts/s13-acceptance.sh
artifacts/
demo-homes/
